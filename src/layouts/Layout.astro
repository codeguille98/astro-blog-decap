---
import Menu from "../components/Menu.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body class="m-0 font-[Arial,sans-serif]">
    <Menu />

    <main class="mx-auto min-h-[70vh] max-w-250 px-5 py-10" >
      <slot />
    </main>

    <footer class="bg-[#eee] p-5 text-center">
      <p>Mi Blog - Astro + Decap CMS</p>
    </footer>
  </body>
</html>